@startuml usecase

left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam dpi 150
skinparam nodesep 18
skinparam ranksep 70
skinparam ArrowFontSize 11
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #444444
  ArrowColor #444444
}
skinparam rectangle {
  BackgroundColor #F7F9FC
  BorderColor #8895A7
}

title Use Case диаграмма системы GradeTrack

actor "Студент" as Student
actor "Преподаватель" as Teacher
actor "Администратор" as Admin

rectangle "Работа студента" {
  usecase "Экспорт данных" as UC_ExportMy
  usecase "Средний балл" as UC_Average
  usecase "Свои оценки" as UC_MyGrades
  usecase "Вход в систему" as UC_StudentLogin
}

rectangle "Работа преподавателя" {
  usecase "Выбор группы" as UC_SelectGroup
  usecase "Выбор дисциплины" as UC_SelectSubject
  usecase "Экспорт отчёта" as UC_ExportReport
  usecase "Список должников" as UC_Debtors
  usecase "Оценки группы" as UC_GroupGrades
  usecase "Удалить оценку" as UC_DelGrade
  usecase "Изменить оценку" as UC_EditGrade
  usecase "Добавить оценку" as UC_AddGrade
  usecase "Вход в систему" as UC_TeacherLogin
}

rectangle "Управление системой" {
  usecase "Удалить дисциплину" as UC_DelSubject
  usecase "Создать дисциплину" as UC_AddSubject
  usecase "Удалить группу" as UC_DelGroup
  usecase "Создать группу" as UC_AddGroup
  usecase "Изменить данные пользователя" as UC_EditUser
  usecase "Удалить преподавателя" as UC_DelTeacher
  usecase "Добавить преподавателя" as UC_AddTeacher
  usecase "Удалить студента" as UC_DelStudent
  usecase "Добавить студента" as UC_AddStudent
  usecase "Вход в систему" as UC_AdminLogin
}

Student -- UC_StudentLogin
Teacher -- UC_TeacherLogin
Admin -- UC_AdminLogin

UC_StudentLogin -- UC_MyGrades

UC_TeacherLogin -- UC_ExportReport
UC_TeacherLogin -- UC_Debtors
UC_TeacherLogin -- UC_GroupGrades
UC_TeacherLogin -- UC_DelGrade
UC_TeacherLogin -- UC_EditGrade
UC_TeacherLogin -- UC_AddGrade

UC_AdminLogin -- UC_DelSubject
UC_AdminLogin -- UC_AddSubject
UC_AdminLogin -- UC_DelGroup
UC_AdminLogin -- UC_AddGroup
UC_AdminLogin -- UC_EditUser
UC_AdminLogin -- UC_DelTeacher
UC_AdminLogin -- UC_AddTeacher
UC_AdminLogin -- UC_DelStudent
UC_AdminLogin -- UC_AddStudent

UC_ExportReport ..> UC_SelectGroup : <<include>>
UC_Debtors ..> UC_SelectGroup : <<include>>
UC_GroupGrades ..> UC_SelectGroup : <<include>>

UC_DelGrade ..> UC_SelectSubject : <<include>>
UC_EditGrade ..> UC_SelectSubject : <<include>>
UC_AddGrade ..> UC_SelectSubject : <<include>>

UC_MyGrades <.. UC_ExportMy : <<extend>>
UC_MyGrades <.. UC_Average : <<extend>>

@enduml
